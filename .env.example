# Copia este archivo a .env SOLO para desarrollo local. En Render se configuran en Environment.
# Nunca subas el .env real al repositorio.

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=la-clave-anon-o-publishable
SUPABASE_SECRET_KEY=la-clave-secreta-de-supabase

R2_ENDPOINT=https://TU-ID.eu.r2.cloudflarestorage.com
R2_BUCKET=misterai
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Orígenes de la web permitidos (separados por comas, sin ruta ni barra final)
ALLOWED_ORIGINS=https://misterai-analitycs.github.io,http://localhost:8000
MAX_FILE_GB=6
URL_TTL_SECONDS=3600
